# Copia este archivo a .env (en local) y rellena los valores.
# En Vercel se añaden en Project Settings > Environment Variables.
# Supabase > botón "Connect" del proyecto, o Settings > API Keys.
# Usa la clave "publishable" (sb_publishable_...). Es pública por diseño; la seguridad la da RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
